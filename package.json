{
  "name": "dsh-web-mobile",
  "version": "3.3.0",
  "description": "DSH Mobile Workbench — mobile-first shell retaining native trajectory and subagents",
  "license": "MIT",
  "author": "mexiaosh",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TTTPOB/dsh-mobile-workbench.git"
  },
  "homepage": "https://github.com/TTTPOB/dsh-mobile-workbench#readme",
  "bugs": {
    "url": "https://github.com/TTTPOB/dsh-mobile-workbench/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "mobile",
    "responsive",
    "deepseek"
  ],
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src",
    "assets/workbench.svg",
    "assets/workbench-180.png",
    "assets/workbench-192.png",
    "assets/workbench-512.png",
    "cordis.patch.yml",
    "README.md",
    "WORKBENCH.md",
    "docs/compatibility.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/clean-build.mjs && tsc -p tsconfig.json && tsc -p tsconfig.client.json && node scripts/build-client.mjs",
    "verify": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.client.json --noEmit",
    "test:core": "node --test tests/*.test.ts",
    "test:browser": "playwright test --project=mobile-390",
    "test:browser:types": "tsc --ignoreConfig --strict --noEmit --skipLibCheck --types node,react --module NodeNext --moduleResolution NodeNext --jsx react-jsx --allowImportingTsExtensions playwright.config.ts tests/browser/*.ts",
    "build:icons": "node scripts/build-workbench-icons.mjs",
    "prepack": "npm run build"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.5",
    "@deepseek-ai/dsh-client-locale": ">=0.2.1-rc.1 <0.3.0",
    "@deepseek-ai/dsh-client-ui-conversation": ">=0.2.1-rc.1 <0.3.0",
    "@deepseek-ai/dsh-client-ui-layout": ">=0.2.1-rc.1 <0.3.0",
    "@deepseek-ai/dsh-client-ui-plugin-manager": "0.2.1-rc.1-fork1",
    "@deepseek-ai/dsh-client-ui-primitives": ">=0.2.1-rc.1 <0.3.0",
    "@deepseek-ai/dsh-client-ui-settings": ">=0.2.1-rc.1 <0.3.0",
    "@deepseek-ai/dsh-client-ui-sidebar": ">=0.2.1-rc.1 <0.3.0",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.2.1-rc.1 <0.3.0",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/cordis-plugin-loader": "1.0.6",
    "@deepseek-ai/dsh-agent": "0.2.1-rc.1",
    "@deepseek-ai/dsh-agent-preset-registry": "0.2.1-rc.1",
    "@deepseek-ai/dsh-api-gateway": "0.2.1-rc.1",
    "@deepseek-ai/dsh-api-remote-access": "0.2.1-rc.1",
    "@deepseek-ai/dsh-api-remotes": "0.2.1-rc.1",
    "@deepseek-ai/dsh-api-session-controller": "0.2.1-rc.1",
    "@deepseek-ai/dsh-api-workspace-controller": "0.2.1-rc.1",
    "@deepseek-ai/dsh-attachment": "0.2.1-rc.1",
    "@deepseek-ai/dsh-client-connection": "0.2.1-rc.1",
    "@deepseek-ai/dsh-client-file-upload": "0.2.1-rc.1",
    "@deepseek-ai/dsh-client-locale": "0.2.1-rc.1",
    "@deepseek-ai/dsh-client-modules": "0.2.1-rc.1",
    "@deepseek-ai/dsh-client-shortcuts": "0.2.1-rc.1",
    "@deepseek-ai/dsh-client-store": "0.2.1-rc.1",
    "@deepseek-ai/dsh-client-ui-chat": "0.2.1-rc.1",
    "@deepseek-ai/dsh-client-ui-conversation": "0.2.1-rc.1",
    "@deepseek-ai/dsh-client-ui-input-trigger": "0.2.1-rc.1",
    "@deepseek-ai/dsh-client-ui-layout": "0.2.1-rc.1",
    "@deepseek-ai/dsh-client-ui-model-selection": "0.2.1-rc.1",
    "@deepseek-ai/dsh-client-ui-plugin-manager": "0.2.1-rc.1-fork1",
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.1-rc.1",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.1-rc.1",
    "@deepseek-ai/dsh-client-ui-session": "0.2.1-rc.1",
    "@deepseek-ai/dsh-client-ui-settings": "0.2.1-rc.1",
    "@deepseek-ai/dsh-client-ui-sidebar": "0.2.1-rc.1",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.1-rc.1",
    "@deepseek-ai/dsh-client-ui-workspace": "0.2.1-rc.1",
    "@deepseek-ai/dsh-commands": "0.2.1-rc.1",
    "@deepseek-ai/dsh-host-directory-picker": "0.2.1-rc.1",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.1",
    "@deepseek-ai/dsh-llm-retry": "0.2.1-rc.1",
    "@deepseek-ai/dsh-native-command": "0.2.1-rc.1",
    "@deepseek-ai/dsh-package-manifest": "0.2.1-rc.1",
    "@deepseek-ai/dsh-session": "0.2.1-rc.1",
    "@deepseek-ai/dsh-session-projection": "0.2.1-rc.1",
    "@deepseek-ai/dsh-session-stats": "0.2.1-rc.1",
    "@deepseek-ai/dsh-subagent": "0.2.1-rc.1",
    "@deepseek-ai/dsh-token-meter": "0.2.1-rc.1",
    "@deepseek-ai/dsh-tool-todo": "0.2.1-rc.1",
    "@deepseek-ai/dsh-typert-protocol": "0.2.1-rc.1",
    "@deepseek-ai/dsh-util-code-language": "0.2.1-rc.1",
    "@deepseek-ai/dsh-util-values": "0.2.1-rc.1",
    "@deepseek-ai/dsh-workspace": "0.2.1-rc.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.0.0",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.0",
    "react": "^18.2.0",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=24.0.0",
    "dsh": ">=0.2.1-rc.1 <0.3.0"
  },
  "packageManager": "pnpm@11.28.5",
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-client-ui-primitives": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-slots": {
      "optional": true
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.5"
  }
}
